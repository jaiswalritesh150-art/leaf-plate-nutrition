# ---- Backend (copy to .env in the repo root or backend/) -- placeholders only, never commit real values ----

# Supabase -> Project Settings -> Database -> Connection string. Use the *pooler* URI on hosts without
# IPv6 (such as Render's free tier) and replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Comma-separated list of browser origins allowed to call the API (your Vercel URL in production).
ALLOWED_ORIGINS=http://localhost:5173

CLINIC_NAME=Leaf & Plate Nutrition
CLINIC_TIMEZONE=Asia/Kolkata
# Mon=0 ... Sun=6. Clients can book on these days.
WORKING_DAYS=0,1,2,3,4,5
DAY_START=09:00
DAY_END=17:00
SLOT_MINUTES=30
BOOKING_HORIZON_DAYS=30
MIN_LEAD_MINUTES=60

# Optional. If set, every /api/admin/* call needs this passcode (the dashboard prompts for it).
# Leave empty for the open, no-login demo mode required by the assignment.
ADMIN_PASSCODE=

# Optional. Added to WhatsApp reminder text so clients can open the app: https://your-app.vercel.app
CLIENT_APP_URL=
